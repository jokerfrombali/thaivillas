// Cloudflare Workers (static assets) deploy for luxuryphuket.net.
// `wrangler deploy` runs the build below first: it copies the site into dist/ without the
// GitHub Pages "/thaivillas" prefix (see tools/cloudflare_build.py), and only dist/ is published.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thaivillas",
  "compatibility_date": "2026-11-01",
  // Worker: serves the static site and POST /api/enquiry (enquiry form -> email, see src/worker.js)
  "main": "src/worker.js",
  // Email Routing must be enabled on luxuryphuket.net; the recipient is the LEAD_TO secret (not in the repo)
  "send_email": [{ "name": "LEADS" }],
  // state for the Zoho Mail <-> Telegram bridge (src/mail.js): refresh token, last seen mail, reply map
  "kv_namespaces": [{ "binding": "STATE", "id": "bf40d445af094eb69bb110f13e8ab08b" }],
  // every minute: new mail from hello@luxuryphuket.net -> Telegram topic "Почта"
  "triggers": { "crons": ["* * * * *"] },
  // Custom domains: Cloudflare creates the DNS records and the SSL certificates on deploy
  // (the zone luxuryphuket.net is in the same Cloudflare account).
  "routes": [
    { "pattern": "luxuryphuket.net", "custom_domain": true },
    { "pattern": "www.luxuryphuket.net", "custom_domain": true }
  ],
  "workers_dev": true,
  "build": {
    "command": "python3 tools/cloudflare_build.py"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
